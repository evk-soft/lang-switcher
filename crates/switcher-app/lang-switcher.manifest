<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Per-Monitor-V2 DPI awareness (ADR-0010). Every screen coordinate the Windows adapter
  produces is claimed to be a physical pixel, and that is only true while this is in
  effect. Microsoft recommends declaring it here rather than through an API.

  Both nodes are intentional: <dpiAware> is the 2005 schema and cannot express
  Per-Monitor-V2, while <dpiAwareness> is the 2016 schema that can. Older systems read the
  first and ignore the second.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0"
          xmlns:asmv3="urn:schemas-microsoft-com:asm.v3">
  <asmv3:application>
    <asmv3:windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </asmv3:windowsSettings>
  </asmv3:application>
</assembly>
